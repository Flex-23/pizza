{
  "name": "pizza-day-night",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "@prisma/engines": true,
    "@swc/core": true,
    "esbuild": true,
    "prisma": true,
    "unrs-resolver": true
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "cpanel:pack": "npm run build && node scripts/package-deploy.mjs",
    "cpanel:pack:fast": "node scripts/package-deploy.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"messages/*.json\"",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "setup": "prisma db push && tsx scripts/create-admin.ts",
    "create:admin": "tsx scripts/create-admin.ts",
    "create:master": "tsx scripts/create-master.ts",
    "hash:password": "tsx scripts/hash-password.ts",
    "set:role": "tsx scripts/set-role.ts",
    "seed:categories": "tsx scripts/seed-categories.ts",
    "gen:streets": "tsx scripts/generate-streets.ts",
    "print:test": "tsx scripts/print-test.ts",
    "archive": "tsx scripts/archive-and-purge.ts",
    "users:purge": "tsx scripts/purge-inactive-users.ts",
    "backup:db": "powershell -ExecutionPolicy Bypass -File scripts/backup-db.ps1",
    "orders:reset": "tsx scripts/reset-orders.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.9",
    "lucide-react": "^1.33.0",
    "mariadb": "^3.5.3",
    "motion": "^13.1.1",
    "next": "16.3.1",
    "next-intl": "^4.13.7",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
