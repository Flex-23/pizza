# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored and is read by both Next.js and Prisma.
# ─────────────────────────────────────────────────────────────

# ── Database: PostgreSQL on Supabase ─────────────────────────
# Both strings are in Supabase → Project Settings → Database → Connection string.
#
# DATABASE_URL is the **pooled** one (host contains `pooler`, port 6543). The app
# uses it, because a serverless deployment opens an instance per request and the
# direct connection runs out of Postgres connections quickly.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL is the **unpooled** one (port 5432). Only the Prisma CLI and the
# maintenance scripts use it — `db push` cannot run through the pooler. It is not
# needed on the deployment host.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Database connections ONE process may hold. Leave EMPTY unless you have a
# reason: the default follows the host — 4 on Vercel, 10 anywhere else.
#   Vercel: every warm instance keeps a pool of its own, so the real figure is
#   this number x instances. Supabase caps pooler clients by compute size
#   (200 on Micro, 400 on Small), and exceeding it takes the project down.
#   One long-running server: this number IS the site's concurrency ceiling.
#   Measured at 3, twenty simultaneous visitors got 500s. Raise it if a busy
#   self-hosted box needs more.
DB_POOL_MAX=""

# Signing key for the session cookie. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public site URL (used for absolute links, sitemap and robots.txt).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Bootstrap admin ──────────────────────────────────────────
# Used only by `npm run create:admin` to create the first manager account.
ADMIN_EMAIL="admin@pizzadaynight.de"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Manager"

# ── Owner (MASTER) ───────────────────────────────────────────
# Used only by `npm run create:master`. MASTER is the owner's account: the whole
# dashboard, and the only role the hidden login page accepts.
MASTER_EMAIL="master@pizzadaynight.de"
MASTER_PASSWORD="Master@Pizza2026"
MASTER_NAME="Master"

# ── Image storage ────────────────────────────────────────────
# "local"    → ./public/uploads. Fine on a machine with a disk of its own.
# "supabase" → Supabase Storage. REQUIRED on Vercel and any other serverless
#              host: their filesystem is wiped on every deploy, so images
#              uploaded to ./public/uploads silently disappear.
STORAGE_DRIVER="supabase"
MAX_UPLOAD_MB="5"

# Needed only when STORAGE_DRIVER="supabase".
# Create a bucket in Supabase → Storage and mark it **Public**, then take the
# URL and the service_role key from Project Settings → API.
# The service_role key bypasses row-level security — keep it server-side only
# and never give it a NEXT_PUBLIC_ prefix.
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="menu-images"

# ── Payments (optional, disabled by default) ─────────────────
# Leave PAYMENTS_ENABLED as "false" to run cash-on-delivery only.
PAYMENTS_ENABLED="false"
PAYMENT_PROVIDER="none"

# ── Order notifications (optional) ───────────────────────────
# WhatsApp number in international format without "+", e.g. 4972186017 26
NOTIFY_WHATSAPP=""
NOTIFY_EMAIL=""

# ── Receipt printing ─────────────────────────────────────────────────────────
# Receipts print on the restaurant's PC, not on this server: the print agent
# there (see agent/README.md) polls /api/print/queue, prints, and reports back.
#
# Shared secret the agent authenticates with — the SAME value goes in the
# agent's config.json. Leave it empty and the print endpoints answer 404 and
# nothing prints, which is the safe default for an unconfigured bridge.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRINT_AGENT_TOKEN=""

# Only used by `npm run print:test`, which drives the printer attached to THIS
# machine directly. Empty means the Windows default printer; set a name (see:
# Get-Printer) to pin one, e.g. "POS-58-Series".
# Test the layout without burning paper:  npm run print:test -- --pdf out.bin
RECEIPT_PRINTER=""

# ── Deploy diagnostics (optional) ────────────────────────────
# URL key for the read-only /api/diag health check. Leave it EMPTY in normal
# operation: the endpoint then answers 404 and is closed by default. Set a key
# only while troubleshooting a deploy, then reach it at /api/diag?key=THEKEY.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DIAG_KEY=""

# ── Data retention (optional; used by `npm run archive`) ──────
# How many days of detailed orders to keep before the archive-and-purge job
# hard-deletes them (their daily takings survive in the archive). Default 90.
ORDER_RETENTION_DAYS="90"
# How many whole calendar months of monthly-report snapshots to keep. A month is
# dropped once its end is more than this many months in the past. Default 3.
REPORT_RETENTION_MONTHS="3"
